# Environment & Server
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="RoadSense AI"
VERSION="2.0.0"

# Authentication & Security
SECRET_KEY=generate_a_random_32_byte_secret_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For Local Dev with SQLite:
DATABASE_URL=sqlite:///./roadsense_production.db
# For Production with PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roadsense_db

# File Storage Limits
MAX_UPLOAD_SIZE_MB=150
RETENTION_DAYS=30

# Model Paths (optional overrides)
# SENSOR_MODEL_PATH=app/ml/weights/roadsense_model.joblib
# YOLO_MODEL_PATH=app/ml/weights/best.pt

# Spatial Memory Correlation Parameters
CORRELATION_MAX_DISTANCE_M=30.0
CORRELATION_MAX_TIME_DIFF_S=4.0
HOTSPOT_CLUSTER_RADIUS_M=25.0
